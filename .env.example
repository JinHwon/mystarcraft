# ─────────────────────────────────────────────
# 마이스타크래프트 백엔드 환경 변수 (오라클 서버)
# cp .env.example .env 후 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# ─────────────────────────────────────────────

# 백엔드 포트 (Demo_Trading 백엔드 3000 과 겹치지 않게 3100 사용)
PORT=3100

# 백엔드 도메인 (nginx/certbot 설정에 사용, 예: mystarcraft.duckdns.org)
DOMAIN=mystarcraft.duckdns.org

# 세션 JWT 서명 키 - 32자 이상 랜덤 문자열 (openssl rand -hex 32)
# 운영(NODE_ENV=production)에서 비어 있거나 짧으면 서버가 시작되지 않습니다.
JWT_SECRET=

# 관리자로 지정할 로그인 아이디 (쉼표로 여러 개). 서버 시작 시 자동으로 관리자 권한 부여
# 아직 가입하지 않은 아이디를 적어 두면, 그 아이디로 먼저 가입한 사람이 관리자가 됩니다.
ADMIN_USERNAMES=wlsgnjs1

# MySQL (deploy/docker-compose.yml)
MYSQL_DATABASE=mystarcraft
MYSQL_USER=mystarcraft
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
# 위 값과 맞춰서 작성: mysql://<USER>:<PASSWORD>@127.0.0.1:<PORT>/<DATABASE>
DATABASE_URL=
