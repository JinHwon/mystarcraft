# ─────────────────────────────────────────────
# 마이스타크래프트 백엔드 환경 변수 (오라클 서버)
# cp .env.example .env 후 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# ─────────────────────────────────────────────

# 백엔드 포트 (Demo_Trading 백엔드 3000 과 겹치지 않게 3100 사용)
PORT=3100

# 백엔드 도메인 (nginx/certbot 설정에 사용, 예: mystarcraft.duckdns.org)
DOMAIN=

# 세션 JWT 서명 키 - 반드시 긴 랜덤 문자열 (openssl rand -hex 32)
JWT_SECRET=

# 관리자 계정: 자체 로그인 아이디가 admin 이면 local_admin
OWNER_OPEN_ID=local_admin

# MySQL (deploy/docker-compose.yml)
MYSQL_DATABASE=mystarcraft
MYSQL_USER=mystarcraft
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
# 위 값과 맞춰서 작성: mysql://<USER>:<PASSWORD>@127.0.0.1:<PORT>/<DATABASE>
DATABASE_URL=

# 선수 사진 업로드 저장 경로 (비우면 프로젝트의 uploads/)
UPLOAD_DIR=

# ── 선택: Manus OAuth / 스토리지를 계속 쓸 때만 설정 ──
# 비워두면 아이디/비밀번호 로그인(/login)과 로컬 디스크 저장을 사용합니다.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
